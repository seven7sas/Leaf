+
+    public boolean exceedsSameCellEntityLimit(final Entity self, final EntityType<?> type, final int blockX, final int blockY, final int blockZ, final double maxSpeedSqr, final int limit) {
+        final EntityCollectionBySection byType = this.entitiesByType.get(type);
+        if (byType == null || byType.count <= limit) {
+            return false;
+        }
+        final int sectionIndex = (blockY >> 4) - this.minSection;
+        if (sectionIndex < 0 || sectionIndex >= byType.entitiesBySection.length) {
+            return false;
+        }
+        final BasicEntityList<Entity> list = byType.entitiesBySection[sectionIndex];
+        if (list == null || list.size() <= limit) {
+            return false;
+        }
+        final Entity[] storage = list.storage;
+        final int len = Math.min(list.size(), storage.length);
+        int count = 0;
+        for (int i = 0; i < len; ++i) {
+            final Entity other = storage[i];
+            if (other != null && other != self && !other.isRemoved()
+                && other.getBlockX() == blockX && other.getBlockY() == blockY && other.getBlockZ() == blockZ
+                && other.getDeltaMovement().lengthSqr() < maxSpeedSqr) {
+                if (++count >= limit) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
