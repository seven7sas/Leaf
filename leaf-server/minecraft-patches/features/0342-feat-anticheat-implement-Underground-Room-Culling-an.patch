+        private boolean isBoostUnderLoad() {
+            if (org.dreeam.leaf.async.chunk.AsyncChunkSend.isOverloaded()) {
+                return true;
+            }
+            final net.minecraft.server.MinecraftServer server = this.world.getServer();
+            if (server == null) {
+                return true;
+            }
+            if (this.sentChunks.size() < 49) {
+                // Ignore single-tick login event spikes during initial 7x7 chunk stream
+                return server.getAverageTickTimeNanos() > 45_000_000L;
+            }
+            final long budgetNanos = server.tickRateManager().nanosecondsPerTick();
+            final long loadThresholdNanos = (budgetNanos * 4L) / 5L;
+            if (server.lagging || server.getAverageTickTimeNanos() > loadThresholdNanos) {
+                return true;
+            }
+            final long loadThresholdMillis = Math.max(1L, loadThresholdNanos / 1_000_000L);
+            return net.minecraft.server.MinecraftServer.lastTickProperTime > loadThresholdMillis;
+        }
+
+        private boolean hasReadyFullChunkPending() {
+            if (!this.sendQueue.isEmpty()) {
+                return true;
+            }
+            if (!this.loadingQueue.isEmpty()) {
+                final long nextLoad = this.loadingQueue.firstLong();
+                if (((ChunkSystemLevel)this.world).moonrise$getAnyChunkIfLoaded(
+                    CoordinateUtils.getChunkX(nextLoad), CoordinateUtils.getChunkZ(nextLoad)) != null) {
+                    return true;
+                }
+            }
+            if (!this.generatingQueue.isEmpty()) {
+                final long nextGen = this.generatingQueue.firstLong();
+                if (((ChunkSystemLevel)this.world).moonrise$getFullChunkIfLoaded(
+                    CoordinateUtils.getChunkX(nextGen), CoordinateUtils.getChunkZ(nextGen)) != null) {
+                    return true;
+                }
+            }
+            if (!this.genQueue.isEmpty()) {
+                final long nextPromote = this.genQueue.firstLong();
+                final NewChunkHolder holder = ((ChunkSystemServerLevel)this.world).moonrise$getChunkTaskScheduler().chunkHolderManager.getChunkHolder(nextPromote);
+                if (holder != null && holder.getCurrentGenStatus() == ChunkStatus.FULL) {
+                    return true;
+                }
+            }
+            return false;
+        }
