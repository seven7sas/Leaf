+    // Leaf start - Underground Room Culling: zero allocation skylight check
+    public boolean isZeroLight() {
+        switch (this.stateVisible) {
+            case INIT_STATE_NULL:
+                return false; // Null state in StarLight = open sky (light level 15)
+            case INIT_STATE_UNINIT:
+            case INIT_STATE_HIDDEN:
+                return true; // Zero light
+            case INIT_STATE_INIT:
+                final byte[] storage = this.storageVisible;
+                if (storage == null) {
+                    return false;
+                }
+                for (int i = 0; i < storage.length; i++) {
+                    if (storage[i] != 0) {
+                        return false;
+                    }
+                }
+                return true;
+            default:
+                return false;
+        }
+    }
+    // Leaf end - Underground Room Culling
