index 825b7326cb22c85e8d766f36eea9dd2a2cbb0673..2608417458c2a78fcf438b6a21a1f6353c29b876 100644
--- a/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
+++ b/net/minecraft/world/level/chunk/storage/RegionFileStorage.java
@@ -444,19 +444,62 @@ public class RegionFileStorage implements AutoCloseable, ca.spottedleaf.moonrise
         }
     }
 
-    @Override
-    public void close() throws IOException {
-        // Paper start - rewrite chunk system
-        synchronized (this) {
-            final ExceptionCollector<IOException> exceptionCollector = new ExceptionCollector<>();
+    @FunctionalInterface
+    private interface RegionFileAction {
+        void run(abomination.IRegionFile regionFile) throws IOException;
+    }
+
+    private void runOnRegionFiles(final RegionFileAction action) throws IOException {
+        final ExceptionCollector<IOException> exceptionCollector = new ExceptionCollector<>();
+        final int size = this.regionCache.size();
+        if (size <= 1) {
             for (final abomination.IRegionFile regionFile : this.regionCache.values()) { // Luminol - Configurable region file format
                 try {
-                    regionFile.close();
+                    action.run(regionFile);
                 } catch (final IOException ex) {
                     exceptionCollector.add(ex);
                 }
             }
-            exceptionCollector.throwIfPresent();
+        } else {
+            // Leaf start - Bounded-worker parallel region file flush/close on I/O pool (bounds native Zstd contexts)
+            final abomination.IRegionFile[] files = this.regionCache.values().toArray(new abomination.IRegionFile[0]);
+            final int workers = Math.min(files.length, Math.clamp(Runtime.getRuntime().availableProcessors() / 2, 2, 4));
+            final java.util.concurrent.atomic.AtomicInteger index = new java.util.concurrent.atomic.AtomicInteger();
+            final java.util.concurrent.ConcurrentLinkedQueue<IOException> asyncExceptions = new java.util.concurrent.ConcurrentLinkedQueue<>();
+            final java.util.List<java.util.concurrent.CompletableFuture<Void>> futures = new java.util.ArrayList<>(workers);
+            final Runnable workerTask = () -> {
+                int i;
+                while ((i = index.getAndIncrement()) < files.length) {
+                    try {
+                        action.run(files[i]);
+                    } catch (final IOException ex) {
+                        asyncExceptions.add(ex);
+                    }
+                }
+            };
+            for (int w = 0; w < workers; w++) {
+                try {
+                    futures.add(java.util.concurrent.CompletableFuture.runAsync(workerTask, net.minecraft.util.Util.ioPool()));
+                } catch (final java.util.concurrent.RejectedExecutionException rejected) {
+                    workerTask.run();
+                }
+            }
+            if (!futures.isEmpty()) {
+                java.util.concurrent.CompletableFuture.allOf(futures.toArray(new java.util.concurrent.CompletableFuture[0])).join();
+            }
+            for (final IOException ex : asyncExceptions) {
+                exceptionCollector.add(ex);
+            }
+            // Leaf end
+        }
+        exceptionCollector.throwIfPresent();
+    }
+
+    @Override
+    public void close() throws IOException {
+        // Paper start - rewrite chunk system
+        synchronized (this) {
+            this.runOnRegionFiles(abomination.IRegionFile::close);
         }
         // Paper end - rewrite chunk system
     }
