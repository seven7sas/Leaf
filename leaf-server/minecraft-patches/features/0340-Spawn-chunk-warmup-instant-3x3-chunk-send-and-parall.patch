+    private static void scheduleSpawnChunkWarmup(
+        final net.minecraft.server.MinecraftServer server,
+        final java.util.UUID uuid,
+        final Optional<CompoundTag> loaded
+    ) {
+        Long worldUuidMost = null;
+        Long worldUuidLeast = null;
+        String worldName = null;
+        String dimensionStr = null;
+        Integer posChunkX = null;
+        Integer posChunkZ = null;
+
+        if (loaded.isPresent()) {
+            final CompoundTag tag = loaded.get();
+            final Optional<Long> most = tag.getLong("WorldUUIDMost");
+            final Optional<Long> least = tag.getLong("WorldUUIDLeast");
+            if (most.isPresent() && least.isPresent()) {
+                worldUuidMost = most.get();
+                worldUuidLeast = least.get();
+            } else {
+                worldName = tag.getString("world").orElse(null);
+            }
+            dimensionStr = tag.getString("Dimension").orElse(null);
+
+            final Optional<net.minecraft.nbt.ListTag> posOpt = tag.getList("Pos");
+            if (posOpt.isPresent()) {
+                final net.minecraft.nbt.ListTag posList = posOpt.get();
+                if (posList.size() >= 3) {
+                    final Optional<Double> xOpt = posList.getDouble(0);
+                    final Optional<Double> zOpt = posList.getDouble(2);
+                    if (xOpt.isPresent() && zOpt.isPresent()) {
+                        final double x = xOpt.get();
+                        final double z = zOpt.get();
+                        if (Double.isFinite(x) && Double.isFinite(z)) {
+                            posChunkX = net.minecraft.util.Mth.floor(x) >> 4;
+                            posChunkZ = net.minecraft.util.Mth.floor(z) >> 4;
+                        }
+                    }
+                }
+            }
+        }
+
+        final Long finalWorldUuidMost = worldUuidMost;
+        final Long finalWorldUuidLeast = worldUuidLeast;
+        final String finalWorldName = worldName;
+        final String finalDimensionStr = dimensionStr;
+        final Integer finalPosChunkX = posChunkX;
+        final Integer finalPosChunkZ = posChunkZ;
+
+        server.execute(() -> {
+            if (server.hasStopped() || server.getPlayerList().getPlayer(uuid) != null) {
+                return;
+            }
+
+            net.minecraft.server.level.ServerLevel targetLevel = null;
+            if (finalWorldUuidMost != null && finalWorldUuidLeast != null) {
+                final org.bukkit.World bWorld = org.bukkit.Bukkit.getServer().getWorld(new java.util.UUID(finalWorldUuidMost, finalWorldUuidLeast));
+                if (bWorld instanceof org.bukkit.craftbukkit.CraftWorld craftWorld) {
+                    targetLevel = craftWorld.getHandle();
+                }
+            } else if (finalWorldName != null) {
+                final org.bukkit.World bWorld = org.bukkit.Bukkit.getServer().getWorld(finalWorldName);
+                if (bWorld instanceof org.bukkit.craftbukkit.CraftWorld craftWorld) {
+                    targetLevel = craftWorld.getHandle();
+                }
+            } else if (finalDimensionStr != null) {
+                final net.minecraft.resources.Identifier dimId = net.minecraft.resources.Identifier.tryParse(finalDimensionStr);
+                if (dimId != null) {
+                    final net.minecraft.resources.ResourceKey<net.minecraft.world.level.Level> dimKey =
+                        net.minecraft.resources.ResourceKey.create(net.minecraft.core.registries.Registries.DIMENSION, dimId);
+                    targetLevel = server.getLevel(dimKey);
+                }
+            }
+
+            final LevelData.RespawnData respawnData = server.getWorldData().overworldData().getRespawnData();
+            if (targetLevel == null) {
+                targetLevel = server.getLevel(respawnData.dimension());
+                if (targetLevel == null) {
+                    targetLevel = server.overworld();
+                }
+            }
+            if (targetLevel == null) {
+                return;
+            }
+
+            final net.minecraft.core.BlockPos respawnPos = respawnData.pos();
+            final int warmupChunkX = finalPosChunkX != null ? finalPosChunkX : net.minecraft.core.SectionPos.blockToSectionCoord(respawnPos.getX());
+            final int warmupChunkZ = finalPosChunkZ != null ? finalPosChunkZ : net.minecraft.core.SectionPos.blockToSectionCoord(respawnPos.getZ());
+
+            final net.minecraft.server.level.ServerLevel warmupLevel = targetLevel;
+            warmupLevel.getChunkSource().mainThreadProcessor.execute(() -> {
+                if (server.hasStopped() || server.getPlayerList().getPlayer(uuid) != null) {
+                    return;
+                }
+                ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) warmupLevel).moonrise$loadChunksAsync(
+                    warmupChunkX - 1, warmupChunkX + 1,
+                    warmupChunkZ - 1, warmupChunkZ + 1,
+                    net.minecraft.world.level.chunk.status.ChunkStatus.FULL,
+                    ca.spottedleaf.concurrentutil.util.Priority.HIGHER,
+                    chunks -> warmupLevel.getChunkSource().mainThreadProcessor.execute(() -> {
+                        if (!server.hasStopped()) {
+                            warmupLevel.getChunkSource().addTicketWithRadius(
+                                net.minecraft.server.level.TicketType.PLAYER_SPAWN,
+                                new net.minecraft.world.level.ChunkPos(warmupChunkX, warmupChunkZ),
+                                1
+                            );
+                        }
+                    })
+                );
+            });
+        });
+    }
+
     private Optional<CompoundTag> loadFromDisk(NameAndId nameAndId) {
         Optional<CompoundTag> optional = this.load(nameAndId, ".dat");
         if (optional.isEmpty()) {
