+    // Leaf start - Precompute Listener hashCode to avoid predicate record hashing on join
+    public static final class Listener<T extends CriterionTriggerInstance> {
+        private final T trigger;
+        private final AdvancementHolder advancement;
+        private final String criterion;
+        private final int cachedHashCode;
+
+        public Listener(T trigger, AdvancementHolder advancement, String criterion) {
+            this.trigger = trigger;
+            this.advancement = advancement;
+            this.criterion = criterion;
+            this.cachedHashCode = 31 * java.util.Objects.hashCode(advancement) + java.util.Objects.hashCode(criterion);
+        }
+
+        public T trigger() {
+            return this.trigger;
+        }
+
+        public AdvancementHolder advancement() {
+            return this.advancement;
+        }
+
+        public String criterion() {
+            return this.criterion;
+        }
+
         public void run(PlayerAdvancements playerAdvancements) {
             playerAdvancements.award(this.advancement, this.criterion);
         }
+
+        @Override
+        public boolean equals(Object obj) {
+            if (this == obj) {
+                return true;
+            }
+            if (!(obj instanceof CriterionTrigger.Listener<?> other)) {
+                return false;
+            }
+            return this.cachedHashCode == other.cachedHashCode
+                && java.util.Objects.equals(this.trigger, other.trigger)
+                && java.util.Objects.equals(this.advancement, other.advancement)
+                && java.util.Objects.equals(this.criterion, other.criterion);
+        }
+
+        @Override
+        public int hashCode() {
+            return this.cachedHashCode;
+        }
+
+        @Override
+        public String toString() {
+            return "Listener[trigger=" + this.trigger + ", advancement=" + this.advancement + ", criterion=" + this.criterion + "]";
+        }
     }
+    // Leaf end - Precompute Listener hashCode to avoid predicate record hashing on join
 }
