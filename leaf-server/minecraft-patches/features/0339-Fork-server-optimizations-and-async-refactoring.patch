+    private static final java.util.concurrent.ConcurrentHashMap<java.util.UUID, java.util.concurrent.atomic.AtomicLong> SAVE_GENERATIONS = new java.util.concurrent.ConcurrentHashMap<>();
+    private static final long PRELOAD_TTL_MS = 120_000L;
+
+    private static Codec<PlayerAdvancements.Data> getWrappedCodec(DataFixer dataFixer) {
+        CachedCodec cached = CACHED_CODEC;
+        if (cached != null && cached.fixer() == dataFixer) {
+            return cached.codec();
+        }
+        Codec<PlayerAdvancements.Data> wrapped = DataFixTypes.ADVANCEMENTS.wrapCodec(PlayerAdvancements.Data.CODEC, dataFixer, 1343);
+        CACHED_CODEC = new CachedCodec(dataFixer, wrapped);
+        return wrapped;
+    }
+
+    public static void clearPreloaded(java.util.@Nullable UUID uuid) {
+        if (uuid == null) {
+            return;
+        }
+        PRELOADED_ADVANCEMENTS.remove(uuid);
+        PRELOADED_TIMESTAMPS.remove(uuid);
+        java.util.concurrent.CompletableFuture<java.util.Optional<PreloadedAdvancements>> future = PRELOAD_FUTURES.remove(uuid);
+        if (future != null) {
+            future.cancel(false);
+        }
+    }
+
+    public static void preloadAsync(MinecraftServer server, java.util.UUID uuid, java.util.concurrent.Executor executor) {
+        if (server.getPlayerList().getPlayer(uuid) != null) {
+            clearPreloaded(uuid);
+            return;
+        }
+        if (PRELOADED_ADVANCEMENTS.size() > 256) {
+            long cutoff = System.currentTimeMillis() - PRELOAD_TTL_MS;
+            PRELOADED_TIMESTAMPS.forEach((k, ts) -> {
+                if (ts < cutoff) {
+                    clearPreloaded(k);
+                }
+            });
+        }
+
+        Path advancementsPath = server.getWorldPath(net.minecraft.world.level.storage.LevelResource.PLAYER_ADVANCEMENTS_DIR).resolve(uuid + ".json");
+        Codec<PlayerAdvancements.Data> advancementCodec = getWrappedCodec(server.getFixerUpper());
+        long genAtStart = SAVE_GENERATIONS.computeIfAbsent(uuid, k -> new java.util.concurrent.atomic.AtomicLong()).get();
