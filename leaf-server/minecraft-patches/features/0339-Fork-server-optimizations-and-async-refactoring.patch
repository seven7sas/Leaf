+    // Leaf start - Async player advancements preloading during login handshake
+    private record CachedCodec(DataFixer fixer, Codec<PlayerAdvancements.Data> codec) {}
+    private record PreloadedAdvancements(Path path, @Nullable Data data) {}
+    private static volatile @Nullable CachedCodec CACHED_CODEC;
+    private static final java.util.concurrent.ConcurrentHashMap<java.util.UUID, PreloadedAdvancements> PRELOADED_ADVANCEMENTS = new java.util.concurrent.ConcurrentHashMap<>();
+    private static final java.util.concurrent.ConcurrentHashMap<java.util.UUID, Long> PRELOADED_TIMESTAMPS = new java.util.concurrent.ConcurrentHashMap<>();
